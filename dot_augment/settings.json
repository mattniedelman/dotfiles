{
  "model": "opus4.5",
  "toolPermissions": [
    {
      "toolName": "remove-files",
      "permission": {
        "type": "ask-user"
      }
    },
    {
      "toolName": "launch-process",
      "permission": {
        "type": "ask-user"
      },
      "shellInputRegex": "\\b(rm|sudo)\\b"
    },
    {
      "toolName": "launch-process",
      "permission": {
        "type": "deny"
      },
      "shellInputRegex": "\\bgit\\b"
    },
    {
      "toolName": "launch-process",
      "permission": {
        "type": "ask-user"
      },
      "shellInputRegex": "(uv add|uv pip install|pip install|poetry add)\\s"
    },
    {
      "toolName": "launch-process",
      "permission": {
        "type": "ask-user"
      },
      "shellInputRegex": "(uv remove|pip uninstall|poetry remove)\\s"
    }
  ],
  "vimMode": false,
