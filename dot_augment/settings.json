  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "/home/mattniedelman",
        "/mnt/2b20906f-1847-4c8e-94e4-b841290bddc3/imprivata"
      ]
    },
    "think-strategies": {
      "command": "npx",
      "args": [
        "github:aaronsb/think-strategies",
        "--storage-path",
        "/home/mattniedelman/Documents/thinking"
      ]
    },
    "basic-memory": {
      "command": "uvx",
      "args": [
        "basic-memory",
        "mcp"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "@cyanheads/git-mcp-server@latest"
      ],
      "env": {
        "MCP_LOG_LEVEL": "info",
        "LOGS_DIR": "~/.augment/logs/git-mcp-server",
        "GIT_USERNAME": "Matt Niedelman",
        "GIT_EMAIL": "matt.niedelman@imprivata.com"
      }
    },
    "kubernetes": {
      "command": "npx",
      "args": [
        "kubernetes-mcp-server@latest",
        "--read-only",
        "--toolsets",
        "core,helm"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project-from-cwd"
      ]
    },
    "ast-grep": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ],
      "env": {
        "AST_GREP_CONFIG": "/home/mattniedelman/.config/ast-grep/sgconfig.yml"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
