{
  "version": "1.0",
  "description": "Declarative skill activation rules for Augment Agent. Controls when skills automatically trigger based on user prompts.",
  "skills": {
    "test-driven-development": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "description": "TDD workflow for any implementation work",
      "promptTriggers": {
        "keywords": [
          "implement",
          "feature",
          "bugfix",
          "fix bug",
          "add functionality",
          "write code"
        ],
        "intentPatterns": [
          "(implement|create|add|build).*?(feature|functionality|method|function|class)",
          "(fix|resolve|debug).*?(bug|issue|error)",
          "write.*?(code|implementation)"
        ]
      }
    },
    "using-git-worktrees": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "description": "Worktree isolation for any code changes",
      "promptTriggers": {
        "keywords": [
          "implement",
          "refactor",
          "fix",
          "change code",
          "modify"
        ],
        "intentPatterns": [
          "(implement|refactor|fix|change|modify|update).*?(code|feature|bug|file)"
        ]
      }
    },
    "verification-before-completion": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "critical",
      "description": "Verification before any completion claims",
      "promptTriggers": {
        "keywords": [
          "done",
          "complete",
          "finished",
          "ready",
          "ship it",
          "merge"
        ],
        "intentPatterns": [
          "(is it|are we|am I).*?(done|complete|ready)",
          "(can we|let's).*?(merge|commit|push|ship)"
        ]
      }
    },
    "brainstorming": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Design exploration before implementation",
      "promptTriggers": {
        "keywords": [
          "design",
          "brainstorm",
          "explore",
          "how should",
          "what approach",
          "architecture"
        ],
        "intentPatterns": [
          "(how should|what approach|best way).*?(implement|design|build|structure)",
          "(brainstorm|explore|think about).*?(design|architecture|approach)"
        ]
      }
    },
    "systematic-debugging": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Systematic approach to debugging",
      "promptTriggers": {
        "keywords": [
          "debug",
          "failing",
          "broken",
          "error",
          "not working",
          "doesn't work"
        ],
        "intentPatterns": [
          "(why|what).*?(failing|broken|not working|error)",
          "(debug|investigate|troubleshoot).*?(issue|problem|bug|error)"
        ]
      }
    },
    "observability-driven-development": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Observability patterns and query planning",
      "promptTriggers": {
        "keywords": [
          "prometheus",
          "grafana",
          "promql",
          "logql",
          "metrics",
          "alerting",
          "dashboard",
          "SLO"
        ],
        "intentPatterns": [
          "(query|check|investigate).*?(metrics|logs|prometheus|grafana)",
          "(create|write|build).*?(promql|logql|query|alert|dashboard)"
        ]
      }
    },
    "helm-kubernetes": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Helm chart and Kubernetes patterns",
      "promptTriggers": {
        "keywords": [
          "helm",
          "kubernetes",
          "k8s",
          "chart",
          "deployment",
          "pod",
          "service",
          "configmap"
        ],
        "intentPatterns": [
          "(create|modify|update|deploy).*?(helm|chart|kubernetes|k8s|deployment)",
          "(how to|best practice).*?(helm|kubernetes|k8s)"
        ]
      }
    },
    "github-actions": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "GitHub Actions workflow authoring",
      "promptTriggers": {
        "keywords": [
          "github actions",
          "CI",
          "workflow",
          "pipeline",
          "actions",
          ".github/workflows"
        ],
        "intentPatterns": [
          "(create|fix|debug|update).*?(workflow|CI|pipeline|action)",
          "(github actions|CI/CD).*?(pattern|best practice)"
        ]
      }
    },
    "receiving-code-review": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Processing code review feedback",
      "promptTriggers": {
        "keywords": [
          "review feedback",
          "reviewer said",
          "PR comments",
          "code review"
        ],
        "intentPatterns": [
          "(reviewer|review|feedback).*?(said|suggested|asked|commented)",
          "(address|respond to|handle).*?(review|feedback|comments)"
        ]
      }
    },
    "storm": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Multi-perspective research",
      "promptTriggers": {
        "keywords": [
          "research",
          "deep dive",
          "comprehensive",
          "multiple perspectives",
          "analyze thoroughly"
        ],
        "intentPatterns": [
          "(research|analyze|investigate|explore).*?(thoroughly|comprehensively|deeply)",
          "(what are|compare|evaluate).*?(options|approaches|tools|frameworks)"
        ]
      }
    },
    "knowledge-capture": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Capture learnings and decisions",
      "promptTriggers": {
        "keywords": [
          "remember",
          "note",
          "capture",
          "document decision",
          "save for later"
        ],
        "intentPatterns": [
          "(remember|note|capture|document).*?(decision|learning|insight)",
          "(save|persist|record).*?(context|knowledge|information)"
        ]
      }
    },
    "continue-conversation": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "medium",
      "description": "Resume previous work from Basic Memory",
      "promptTriggers": {
        "keywords": [
          "continue",
          "resume",
          "pick up",
          "where we left",
          "last time",
          "previous session"
        ],
        "intentPatterns": [
          "(continue|resume|pick up).*?(from|where|previous|last)",
          "(what were we|where did we).*?(working on|doing|leave off)"
        ]
      }
    }
  },
  "notes": {
    "enforcement_types": {
      "block": "Skill MUST be invoked before proceeding (guardrail)",
      "suggest": "Skill suggestion appears, proceeding allowed",
      "warn": "Warning shown, proceeding allowed"
    },
    "priority_levels": {
      "critical": "Always trigger - cannot proceed without",
      "high": "Strongly recommended - trigger on any match",
      "medium": "Recommended - trigger on clear matches",
      "low": "Optional - trigger only on explicit matches"
    }
  }
}
