# Ghostty config - replicated from kitty setup
# ==============================================

# Font settings (matching kitty)
font-family = "Hack Nerd Font"
font-size = 13

# Scrollback (matching kitty's 100000 lines)
scrollback-limit = 100000000

# Copy on select (like kitty's copy_on_select yes)
copy-on-select = clipboard
app-notifications = no-clipboard-copy

# Window decorations
window-decoration = true

# Theme
theme = Kanagawa Wave

# Split styling
unfocused-split-opacity = 0.9
split-divider-color = #54546D

# Rendering options for smoother splits
window-vsync = true
alpha-blending = linear-corrected
async-backend = io_uring

# Resize overlay position
resize-overlay-position = bottom-right

# -----------------------------------------------------------------------------
# Keybindings
# -----------------------------------------------------------------------------
# Split/pane keybindings removed - using zellij for multiplexing
# (Ctrl+h/j/k/l, Ctrl+\, Ctrl+-, Ctrl+Shift+w, Ctrl+Alt+z now handled by zellij)

# Font size adjustment
keybind = ctrl+shift+equal=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1

# Reset window size
keybind = ctrl+home=reset_window_size

# Disable Ctrl+Shift+t to avoid collision with zellij
# (zellij now uses Ctrl+Shift+t to open a new tab)
keybind = ctrl+shift+t=unbind

# Disable Ctrl+- to allow zellij to use it for horizontal splits
keybind = ctrl+-=unbind

# Disable Ctrl+Shift+w to allow zellij to use it for closing panes
keybind = ctrl+shift+w=unbind

# Pass Super+o and Super+t through to Zellij (zellij-project-sidebar)
keybind = super+o=unbind
keybind = super+t=unbind
