// Single worktree tab layout - add to existing session
//
// Usage: Navigate to worktree, then:
//   zellij action new-tab -l ~/.config/zellij/layouts/auggie-worktree-tab.kdl -n "feature-name"
//
// Or with explicit cwd:
//   zellij action new-tab -l ~/.config/zellij/layouts/auggie-worktree-tab.kdl -c /path/to/.worktrees/feature -n "feature-name"

layout {
    pane split_direction="vertical" {
        // Left side: Shell (40%) - for running tests, git status, etc.
        pane name="shell" size="40%" {
            focus true
        }

        // Right side: auggie (60%) - main working area
        pane name="auggie" command="auggie" {
            args "chat"
            start_suspended true
        }
    }
}
