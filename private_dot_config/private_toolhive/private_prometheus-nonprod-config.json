{
  "schema_version": "v0.1.0",
  "image": "ghcr.io/pab1it0/prometheus-mcp-server:latest",
  "name": "prometheus-nonprod",
  "container_name": "prometheus-nonprod",
  "base_name": "prometheus-nonprod",
  "transport": "stdio",
  "host": "127.0.0.1",
  "port": 56108,
  "target_host": "127.0.0.1",
  "permission_profile": {
    "name": "network",
    "network": {
      "outbound": {
        "insecure_allow_all": true
      },
      "inbound": {}
    }
  },
  "env_vars": {
    "MCP_TRANSPORT": "stdio",
    "PROMETHEUS_URL": "http://240.0.0.1:9090/workspaces/ws-b25da60b-d7ee-4254-82ac-0a8210a99d8ae2"
  },
  "container_labels": {
    "toolhive": "true",
    "toolhive-basename": "prometheus-nonprod",
    "toolhive-name": "prometheus-nonprod",
    "toolhive-port": "56108",
    "toolhive-transport": "stdio"
  },
  "proxy_mode": "streamable-http",
  "group": "default",
  "ignore_config": {
    "LoadGlobal": true,
    "PrintOverlays": false
  },
  "middleware_configs": [
    {
      "type": "auth",
      "parameters": {}
    },
    {
      "type": "mcp-parser",
      "parameters": {}
    },
    {
      "type": "usagemetrics",
      "parameters": {}
    },
    {
      "type": "recovery",
      "parameters": null
    }
  ]
}
