{
  "schema_version": "v0.1.0",
  "image": "ghcr.io/github/github-mcp-server:v0.30.3",
  "name": "github",
  "container_name": "github",
  "base_name": "github",
  "transport": "stdio",
  "host": "127.0.0.1",
  "port": 41957,
  "target_host": "127.0.0.1",
  "permission_profile": {
    "network": {
      "outbound": {
        "allow_host": [
          ".github.com",
          ".githubusercontent.com"
        ],
        "allow_port": [
          443
        ]
      }
    }
  },
  "env_vars": {
    "MCP_TRANSPORT": "stdio"
  },
  "container_labels": {
    "toolhive": "true",
    "toolhive-basename": "github",
    "toolhive-name": "github",
    "toolhive-port": "41957",
    "toolhive-transport": "stdio"
  },
  "secrets": [
    "registry-user-github_personal_access_token,target=GITHUB_PERSONAL_ACCESS_TOKEN"
  ],
  "proxy_mode": "streamable-http",
  "group": "default",
  "ignore_config": {
    "LoadGlobal": true,
    "PrintOverlays": false
  },
  "middleware_configs": [
    {
      "type": "auth",
      "parameters": {}
    },
    {
      "type": "mcp-parser",
      "parameters": {}
    },
    {
      "type": "usagemetrics",
      "parameters": {}
    },
    {
      "type": "recovery",
      "parameters": null
    }
  ]
}
