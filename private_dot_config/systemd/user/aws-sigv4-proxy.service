[Unit]
Description=AWS SigV4 Signing Proxy for AMP
After=network.target

[Service]
Type=simple
ExecStart=/home/mattniedelman/.local/share/mise/installs/aws-sigv4-proxy/1.11.1/bin/aws-sigv4-proxy \
    --name aps \
    --region us-east-2 \
    --host aps-workspaces.us-east-2.amazonaws.com \
    --port :9090
Restart=on-failure
RestartSec=5
Environment="AWS_SDK_LOAD_CONFIG=true"
Environment="AWS_PROFILE=default"

[Install]
WantedBy=default.target

