{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": "╭─",
          "trailing_diamond": "",
          "background": "#e67e80",
          "foreground": "#2b3339",
          "template": "  "
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "╭─",
          "trailing_diamond": "",
          "background": "#3a454a",
          "foreground": "#a7c080",
          "template": " {{ .Env.OMP_PATH }} "
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#445055",
          "foreground": "#83c092",
          "template": " {{ .HEAD }} ",
          "properties": {
            "branch_icon": " "
          }
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": " ",
          "trailing_diamond": "",
          "background": "#3a454a",
          "foreground": "#83c092",
          "template": "{{- if contains \"/.worktrees/\" .Env.PWD }} ⎇ {{- splitList \"/.worktrees/\" .Env.PWD | last | splitList \"/\" | first -}}{{- end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "#445055",
          "foreground": "#9da9a0",
          "template": "  {{ .FormattedMs }}⠀",
          "properties": {
            "style": "roundrock",
            "threshold": 500
          }
        },
        {
          "type": "node",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#a7c080",
          "template": " {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}",
          "properties": {
            "fetch_package_manager": true,
            "npm_icon": " ",
            "yarn_icon": " "
          }
        },
        {
          "type": "python",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#dbbc7f",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }}"
        },
        {
          "type": "java",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#e69875",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
        },
        {
          "type": "dotnet",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#7fbbb3",
          "template": " {{ if .Unsupported }}{{ else }}{{ .Full }}{{ end }}"
        },
        {
          "type": "go",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#83c092",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
        },
        {
          "type": "rust",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#e67e80",
          "template": " {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}"
        },
        {
          "type": "terraform",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#d699b6",
          "template": " {{ .WorkspaceName }}"
        },
        {
          "type": "aws",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#dbbc7f",
          "template": " {{.Profile}}"
        },
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#3a454a",
          "foreground": "#7fbbb3",
          "template": " {{ splitList \"/\" .Context | last }}{{if .Namespace}} :: {{.Namespace}}{{end}}",
          "background_templates": [
            "{{ if eq (splitList \"/\" .Context | last) \"ai-prod\" }}#e67e80{{ end }}"
          ],
          "foreground_templates": [
            "{{ if eq (splitList \"/\" .Context | last) \"ai-prod\" }}#2b3339{{ end }}"
          ]
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#2b3339",
          "foreground": "#7fbbb3",
          "template": "{{ .Env.CLAUDE_MODEL_NERD }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#2b3339",
          "foreground": "#83c092",
          "template": "{{ .Env.CLAUDE_CONTEXT }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#2b3339",
          "foreground": "#a7c080",
          "template": "{{ .Env.CLAUDE_COST }}"
        },
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": " ",
          "background": "#2b3339",
          "foreground": "#dbbc7f",
          "template": "{{- $a := .Env.CLAUDE_LINES_ADDED | default \"0\" | int -}}{{- $r := .Env.CLAUDE_LINES_REMOVED | default \"0\" | int -}}{{- if or (gt $a 0) (gt $r 0) }}+{{ $a }}/-{{ $r }}{{- end -}}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#83c092",
          "template": "╰─"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#d3c6aa",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#e67e80{{ end }}"
          ],
          "template": " ",
          "properties": {
            "always_enabled": true
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "text",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "background": "#2b3339",
          "foreground": "#d3c6aa",
          "template": "{{- if .Env.CLAUDE_SUMMARY -}}{{- $s := .Env.CLAUDE_SUMMARY -}}{{- if gt (len $s) 60 }}{{ substr 0 57 $s }}...{{- else }}{{ $s }}{{- end -}}{{- end -}}"
        }
      ]
    }
  ]
}