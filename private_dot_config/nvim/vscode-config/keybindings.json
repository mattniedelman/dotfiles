[
  // ============================================================================
  // Augment Code Completion
  // ============================================================================
  {
    "key": "ctrl+f",
    "command": "augment.acceptSuggestion",
    "when": "editorTextFocus && augmentSuggestionVisible"
  },
  {
    "key": "ctrl+y",
    "command": "augment.acceptSuggestion",
    "when": "editorTextFocus && augmentSuggestionVisible"
  },

  // ============================================================================
  // Disable conflicting keybindings
  // ============================================================================
  
  // Disable Ctrl+F for find (use / in Neovim normal mode instead)
  {
    "key": "ctrl+f",
    "command": "-actions.find",
    "when": "!augmentSuggestionVisible"
  },

  // ============================================================================
  // File Navigation (matching LazyVim defaults)
  // ============================================================================
  
  // File explorer toggle (LazyVim: <leader>e)
  {
    "key": "space e",
    "command": "workbench.view.explorer",
    "when": "vim.mode == 'Normal'"
  },
  
  // Find files (LazyVim: <leader>ff)
  {
    "key": "space f f",
    "command": "workbench.action.quickOpen",
    "when": "vim.mode == 'Normal'"
  },
  
  // Live grep / search in files (LazyVim: <leader>fg or <leader>/)
  {
    "key": "space f g",
    "command": "workbench.action.findInFiles",
    "when": "vim.mode == 'Normal'"
  },
  {
    "key": "space /",
    "command": "workbench.action.findInFiles",
    "when": "vim.mode == 'Normal'"
  },
  
  // Recent files (LazyVim: <leader>fr)
  {
    "key": "space f r",
    "command": "workbench.action.openRecent",
    "when": "vim.mode == 'Normal'"
  },

  // ============================================================================
  // Buffer/Tab Management (matching LazyVim defaults)
  // ============================================================================
  
  // Close current buffer (LazyVim: <leader>bd)
  {
    "key": "space b d",
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal'"
  },
  
  // Next buffer (LazyVim: ]b)
  {
    "key": "] b",
    "command": "workbench.action.nextEditor",
    "when": "vim.mode == 'Normal'"
  },
  
  // Previous buffer (LazyVim: [b)
  {
    "key": "[ b",
    "command": "workbench.action.previousEditor",
    "when": "vim.mode == 'Normal'"
  },

  // ============================================================================
  // LSP Actions (matching LazyVim defaults)
  // ============================================================================
  
  // Go to definition (LazyVim: gd)
  {
    "key": "g d",
    "command": "editor.action.revealDefinition",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Go to references (LazyVim: gr)
  {
    "key": "g r",
    "command": "editor.action.goToReferences",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Go to implementation (LazyVim: gI)
  {
    "key": "g shift+i",
    "command": "editor.action.goToImplementation",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Go to type definition (LazyVim: gy)
  {
    "key": "g y",
    "command": "editor.action.goToTypeDefinition",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Show hover documentation (LazyVim: K)
  {
    "key": "shift+k",
    "command": "editor.action.showHover",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Rename symbol (LazyVim: <leader>cr)
  {
    "key": "space c r",
    "command": "editor.action.rename",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Code actions (LazyVim: <leader>ca)
  {
    "key": "space c a",
    "command": "editor.action.quickFix",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Format document (LazyVim: <leader>cf)
  {
    "key": "space c f",
    "command": "editor.action.formatDocument",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },

  // ============================================================================
  // Diagnostics (matching LazyVim defaults)
  // ============================================================================
  
  // Next diagnostic (LazyVim: ]d)
  {
    "key": "] d",
    "command": "editor.action.marker.next",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Previous diagnostic (LazyVim: [d)
  {
    "key": "[ d",
    "command": "editor.action.marker.prev",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Show diagnostics (LazyVim: <leader>cd)
  {
    "key": "space c d",
    "command": "workbench.actions.view.problems",
    "when": "vim.mode == 'Normal'"
  },

  // ============================================================================
  // Git Integration (matching LazyVim defaults)
  // ============================================================================
  
  // Git status (LazyVim: <leader>gs)
  {
    "key": "space g s",
    "command": "workbench.view.scm",
    "when": "vim.mode == 'Normal'"
  },
  
  // Git blame (LazyVim: <leader>gb)
  {
    "key": "space g b",
    "command": "gitlens.toggleLineBlame",
    "when": "vim.mode == 'Normal'"
  },
  
  // Next hunk (LazyVim: ]h)
  {
    "key": "] h",
    "command": "workbench.action.editor.nextChange",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Previous hunk (LazyVim: [h)
  {
    "key": "[ h",
    "command": "workbench.action.editor.previousChange",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },

  // ============================================================================
  // Terminal (matching LazyVim defaults)
  // ============================================================================
  
  // Toggle terminal (LazyVim: <leader>ft or <C-/>)
  {
    "key": "space f t",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "vim.mode == 'Normal'"
  },
  {
    "key": "ctrl+/",
    "command": "workbench.action.terminal.toggleTerminal"
  },

  // ============================================================================
  // Window Management (matching LazyVim defaults)
  // ============================================================================
  
  // Split window vertically (LazyVim: <leader>|)
  {
    "key": "space |",
    "command": "workbench.action.splitEditorRight",
    "when": "vim.mode == 'Normal'"
  },
  
  // Split window horizontally (LazyVim: <leader>-)
  {
    "key": "space -",
    "command": "workbench.action.splitEditorDown",
    "when": "vim.mode == 'Normal'"
  },
  
  // Close window (LazyVim: <leader>wd)
  {
    "key": "space w d",
    "command": "workbench.action.closeActiveEditor",
    "when": "vim.mode == 'Normal'"
  },

  // ============================================================================
  // Search and Replace (matching LazyVim defaults)
  // ============================================================================
  
  // Search and replace in current file (LazyVim: <leader>sr)
  {
    "key": "space s r",
    "command": "editor.action.startFindReplaceAction",
    "when": "vim.mode == 'Normal' && editorTextFocus"
  },
  
  // Search and replace in workspace (LazyVim: <leader>sR)
  {
    "key": "space s shift+r",
    "command": "workbench.action.replaceInFiles",
    "when": "vim.mode == 'Normal'"
  },

  // ============================================================================
  // Miscellaneous
  // ============================================================================
  
  // Command palette (LazyVim: <leader><leader>)
  {
    "key": "space space",
    "command": "workbench.action.showCommands",
    "when": "vim.mode == 'Normal'"
  },
  
  // Save file (LazyVim: <leader>w)
  {
    "key": "space w",
    "command": "workbench.action.files.save",
    "when": "vim.mode == 'Normal'"
  },
  
  // Quit (LazyVim: <leader>q)
  {
    "key": "space q",
    "command": "workbench.action.closeWindow",
    "when": "vim.mode == 'Normal'"
  },

  // ============================================================================
  // Python-specific (matching your venv-selector setup)
  // ============================================================================
  
  // Select Python interpreter (LazyVim: <leader>cv)
  {
    "key": "space c v",
    "command": "python.setInterpreter",
    "when": "vim.mode == 'Normal' && editorLangId == 'python'"
  }
]

