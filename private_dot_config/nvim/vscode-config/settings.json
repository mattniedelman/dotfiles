{
  // ============================================================================
  // VSCode Neovim Extension Configuration
  // ============================================================================
  "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim",
  "vscode-neovim.neovimInitVimPaths.linux": "~/.config/nvim/init.lua",
  "vscode-neovim.useCtrlKeysForNormalMode": true,
  "vscode-neovim.useCtrlKeysForInsertMode": false,
  
  // Enable Neovim to handle these keys
  "vscode-neovim.ctrlKeysNormal": [
    "h",
    "j",
    "k",
    "l",
    "w",
    "b",
    "d",
    "u",
    "o",
    "f",
    "y"
  ],

  // ============================================================================
  // Editor Settings (matching Neovim behavior)
  // ============================================================================
  "editor.lineNumbers": "relative",
  "editor.cursorBlinking": "solid",
  "editor.cursorSurroundingLines": 8,
  "editor.scrollBeyondLastLine": false,
  "editor.wordWrap": "off",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.suggest.insertMode": "replace",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.rulers": [80, 120],
  "editor.renderLineHighlight": "all",
  "editor.smoothScrolling": false,
  "editor.cursorStyle": "block",
  "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },

  // ============================================================================
  // Files and Search
  // ============================================================================
  "files.autoSave": "off",
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },

  // ============================================================================
  // Workbench and UI
  // ============================================================================
  "workbench.colorTheme": "Kanagawa",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.list.smoothScrolling": false,
  "workbench.tree.indent": 16,
  "workbench.activityBar.location": "default",
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "custom",
  "breadcrumbs.enabled": true,

  // ============================================================================
  // Terminal
  // ============================================================================
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.scrollback": 10000,

  // ============================================================================
  // Python Configuration (matching your Neovim setup)
  // ============================================================================
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    },
    "editor.tabSize": 4,
    "editor.rulers": [88, 120]
  },

  // Python extension settings
  "python.languageServer": "None",
  "python.analysis.typeCheckingMode": "off",
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.autoImportCompletions": true,

  // Basedpyright LSP (matching your Neovim config)
  "basedpyright.analysis.typeCheckingMode": "standard",
  "basedpyright.analysis.diagnosticMode": "workspace",
  "basedpyright.analysis.autoImportCompletions": true,
  "basedpyright.analysis.autoSearchPaths": true,
  "basedpyright.analysis.useLibraryCodeForTypes": true,

  // Ruff (matching your Neovim config)
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.format.args": [],
  "ruff.lint.args": [
    "--unfixable=F401"
  ],

  // ============================================================================
  // Language-Specific Formatting
  // ============================================================================
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },

  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
    "editor.formatOnSave": true
  },

  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // ============================================================================
  // Git Configuration
  // ============================================================================
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "always",
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,

  // ============================================================================
  // Extension-Specific Settings
  // ============================================================================
  
  // Augment Code (AI completion)
  "augment.enable": true,
  "augment.acceptSuggestionOnTab": false,
  
  // Disable conflicting IntelliSense
  "editor.parameterHints.enabled": true,
  "editor.suggestOnTriggerCharacters": true,
  
  // Error Lens
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  
  // Indent Rainbow
  "indentRainbow.colors": [
    "rgba(64,64,16,0.3)",
    "rgba(32,64,32,0.3)",
    "rgba(64,32,64,0.3)",
    "rgba(16,48,48,0.3)"
  ],

  // Todo Tree
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "NOTE",
    "HACK",
    "XXX",
    "BUG"
  ],

  // ============================================================================
  // Disable VSCode features that conflict with Neovim
  // ============================================================================
  "editor.hover.enabled": false,
  "editor.lightbulb.enabled": "off",
  "editor.selectionHighlight": false,
  "editor.occurrencesHighlight": "off",
  "editor.matchBrackets": "never",
  "editor.colorDecorators": false,
  "editor.folding": false,
  "editor.glyphMargin": false,
  "workbench.tips.enabled": false,
  "extensions.ignoreRecommendations": true,

  // ============================================================================
  // Telemetry and Privacy
  // ============================================================================
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false
}

