# KICS Configuration File Example
# Copy this to .kics.config in your project root and customize as needed
# See: https://docs.kics.io/latest/configuration-file/

# Paths to scan (can be overridden by CLI)
path:
  - "."

# Paths to exclude from scanning
exclude-paths:
  - ".git/"
  - ".terraform/"
  - "node_modules/"
  - "vendor/"
  - ".venv/"
  - "__pycache__/"
  - "*.tfstate"
  - "*.tfstate.backup"

# Exclude specific queries by ID
# Find query IDs at: https://docs.kics.io/latest/queries/
exclude-queries:
  # Example: Uncomment to exclude specific queries
  # - "e69890e6-fce5-461d-98ad-cb98318dfc96"  # Example query ID

# Exclude by severity
exclude-severities:
  - "trace"
  # Uncomment to exclude more:
  # - "info"
  # - "low"

# Exclude by category
exclude-categories:
  # Example categories to exclude:
  # - "Backup"
  # - "Best Practices"
  # - "Insecure Configurations"

# Cloud providers to scan (leave empty for all)
cloud-provider:
  # - "aws"
  # - "azure"
  # - "gcp"
  # - "alicloud"
  # - "tencentcloud"

# Platform types to scan (leave empty for all)
type:
  # - "Terraform"
  # - "Kubernetes"
  # - "Dockerfile"
  # - "CloudFormation"
  # - "Ansible"

# Output configuration
output-path: "./kics-results"
output-name: "results"
report-formats:
  - "json"
  # - "sarif"
  # - "html"
  # - "pdf"

# Fail on specific severities (for CI/CD)
fail-on:
  - "critical"
  - "high"
  - "medium"
  # - "low"
  # - "info"

# Query timeout in seconds
timeout: 60

# Disable full descriptions (faster scanning)
disable-full-descriptions: false

# Disable secrets scanning
disable-secrets: false

# Include Bill of Materials in results
bom: false

# Minimal UI output
minimal-ui: false

# Number of lines to display in results
preview-lines: 3

# Verbose logging
verbose: false

# Log level (TRACE, DEBUG, INFO, WARN, ERROR, FATAL)
log-level: "INFO"

# Log format (pretty, json)
log-format: "pretty"

