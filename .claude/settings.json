{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "autoMemoryEnabled": false,
  "autoUpdates": false,
  "autoUpdatesChannel": "latest",
  "awsAuthRefresh": "aws sso login --profile claude",
  "cleanupPeriodDays": 365,
  "effortLevel": "medium",
  "enabledPlugins": {},
  "env": {
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "us.anthropic.claude-haiku-4-5-20251001-v1:0",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "us.anthropic.claude-opus-5[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "us.anthropic.claude-sonnet-5[1m]",
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_PROFILE": "claude",
    "AWS_REGION": "us-east-1",
    "AWS_SDK_LOAD_CONFIG": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "RTK_HOOK_AUDIT": "1"
  },
  "extraKnownMarketplaces": {
    "evo-hq-evo": {
      "source": {
        "repo": "evo-hq/evo",
        "source": "github"
      }
    },
    "hindsight": {
      "source": {
        "repo": "vectorize-io/hindsight",
        "source": "github"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "repo": "anthropics/knowledge-work-plugins",
        "source": "github"
      }
    },
    "pydantic-skills": {
      "source": {
        "repo": "pydantic/skills",
        "source": "github"
      }
    },
    "revealjs-skill": {
      "source": {
        "repo": "ryanbbrown/revealjs-skill",
        "source": "github"
      }
    },
    "sparkrun": {
      "source": {
        "repo": "spark-arena/sparkrun",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/auto_lint.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/ascii_check.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/agnix_validate.py",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/security_audit_nudge.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/security_audit_nudge.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_help_grep.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/basic_memory_directory_check.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__basic-memory__write_note"
      },
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/block_pip.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/rtk-rewrite.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/worktree_placement_check.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/allow_sandboxed_bash.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_broad_search.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "resume"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "clear"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      },
      {
        "hooks": [
          {
            "command": "bash '/home/mattniedelman/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_reflect.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/brag_capture.py",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "us.anthropic.claude-opus-4-8[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Write",
      "Edit",
      "mcp__basic-memory__*",
      "mcp__beads__*",
      "mcp__plugin_ketch_ketch__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_cq_cq__*",
      "Bash(rtk:*)",
      "Bash(chezmoi:*)",
      "Bash(bd:*)",
      "Bash(br:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(systemctl:*)",
      "Bash(aws:*)",
      "Bash(nono why *)",
      "Bash(nono profile guide)",
      "Bash(nono profile show *)",
      "Bash(nono profile groups *)",
      "Bash(nono profile validate *)",
      "Bash(nono profile schema)",
      "Bash(nono audit list *)",
      "Bash(nono audit show *)",
      "Bash(hk config *)",
      "Bash(hk check *)",
      "Bash(hk validate *)",
      "Bash(hk builtins *)",
      "Bash(skillshare list *)",
      "Bash(desloppify next *)",
      "mcp__grafana__*",
      "mcp__semble__*",
      "Skill(*)"
    ],
    "ask": [
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.config/fish/config.fish)",
      "Edit(~/.config/fish/conf.d/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": false
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.local/bin/starship-claude",
    "padding": 0,
    "type": "command"
  },
  "teammateMode": "auto",
  "theme": "dark",
  "tui": "fullscreen",
  "verbose": false
}
