{
  "theme": "nord",
  "display": {
    "style": "capsule",
    "charset": "unicode",
    "colorCompatibility": "auto",
    "autoWrap": true,
    "padding": 1,
    "lines": [
      {
        "segments": {
          "directory": {
            "enabled": true,
            "style": "fish"
          },
          "git": {
            "enabled": true
          },
          "model": {
            "enabled": true
          },
          "session": {
            "enabled": true,
            "type": "both",
            "costSource": "calculated"
          }
        }
      },
      {
        "segments": {
          "today": {
            "enabled": true,
            "type": "cost"
          },
          "weekly": {
            "enabled": true,
            "displayStyle": "blocks"
          },
          "context": {
            "enabled": true,
            "showPercentageOnly": false,
            "displayStyle": "blocks",
            "autocompactBuffer": 33000
          }
        }
      },
      {
        "segments": {
          "metrics": {
            "enabled": true,
            "showResponseTime": false,
            "showLastResponseTime": false,
            "showDuration": true,
            "showMessageCount": true,
            "showLinesAdded": false,
            "showLinesRemoved": false
          },
          "version": {
            "enabled": true
          }
        }
      }
    ]
  },
  "budget": {
    "today": {
      "amount": 100,
      "warningThreshold": 80
    }
  },
  "modelContextLimits": {
    "sonnet": 1000000,
    "opus": 1000000
  }
}
