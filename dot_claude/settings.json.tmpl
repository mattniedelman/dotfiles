{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_PROFILE": "claude",
    "AWS_REGION": "us-east-1",
    "AWS_SDK_LOAD_CONFIG": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "RTK_HOOK_AUDIT": "1"
  },
  "awsAuthRefresh": "aws sso login --profile claude",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Write",
      "Edit",
      "mcp__basic-memory__*",
      "mcp__beads__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_cq_cq__*",
      "Bash(rtk:*)",
      "Bash(chezmoi:*)",
      "Bash(bd:*)",
      "Bash(br:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(systemctl:*)",
      "Bash(aws:*)",
      "Bash(nono why *)",
      "Bash(nono profile guide)",
      "Bash(nono profile show *)",
      "Bash(nono profile groups *)",
      "Bash(nono profile validate *)",
      "Bash(nono profile schema)",
      "Bash(nono audit list *)",
      "Bash(nono audit show *)",
      "Bash(hk config *)",
      "Bash(hk check *)",
      "Bash(hk validate *)",
      "Bash(hk builtins *)",
      "Bash(skillshare list *)",
      "Bash(desloppify next *)",
      "mcp__grafana__*",
      "mcp__semble__*",
      "Skill(*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.ssh/**)"
    ],
    "ask": [
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.config/fish/config.fish)",
      "Edit(~/.config/fish/conf.d/**)"
    ]
  },
  "model": "us.anthropic.claude-sonnet-5",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto_lint.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/ascii_check.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/agnix_validate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/security_audit_nudge.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/security_audit_nudge.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer_help_grep.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__basic-memory__write_note",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/basic_memory_directory_check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block_pip.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rtk-rewrite.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/worktree_placement_check.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/allow_sandboxed_bash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer_broad_search.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/steer_search_discipline.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/mattniedelman/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session_reflect.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/brag_capture.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/starship-claude",
    "padding": 0
  },
  "enabledPlugins": {
    "agentic-actions-auditor@trailofbits": false,
    "agnix@agentsys": true,
    "ai@pydantic-skills": true,
    "ask-questions-if-underspecified@trailofbits": false,
    "audit-context-building@trailofbits": false,
    "audit-project@agentsys": false,
    "can-i-help@agentsys": false,
    "differential-review@trailofbits": false,
    "drift-detect@agentsys": false,
    "enhance@agentsys": true,
    "evo@evo-hq-evo": true,
    "git-cleanup@trailofbits": false,
    "hindsight-memory@hindsight": true,
    "insecure-defaults@trailofbits": true,
    "learn@agentsys": false,
    "nono@always-further": true,
    "onboard@agentsys": true,
    "perf@agentsys": false,
    "repo-intel@agentsys": true,
    "sharp-edges@trailofbits": true,
    "skill-improver@trailofbits": true,
    "skillers@agentsys": false,
    "skypilot@skypilot": true,
    "sparkrun@sparkrun": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "sync-docs@agentsys": true,
    "trailmark@trailofbits": true,
    "variant-analysis@trailofbits": true,
    "workflow-skill-design@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "agentsys": {
      "source": {
        "source": "github",
        "repo": "agent-sh/agentsys"
      },
      "autoUpdate": true
    },
    "evo-hq-evo": {
      "source": {
        "source": "github",
        "repo": "evo-hq/evo"
      }
    },
    "hindsight": {
      "source": {
        "source": "github",
        "repo": "vectorize-io/hindsight"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/knowledge-work-plugins"
      }
    },
    "probo": {
      "source": {
        "source": "git",
        "url": "https://github.com/getprobo/probo.git"
      }
    },
    "pydantic-skills": {
      "source": {
        "source": "github",
        "repo": "pydantic/skills"
      }
    },
    "revealjs-skill": {
      "source": {
        "source": "github",
        "repo": "ryanbbrown/revealjs-skill"
      }
    },
    "skypilot": {
      "source": {
        "source": "github",
        "repo": "skypilot-org/skypilot"
      }
    },
    "sparkrun": {
      "source": {
        "source": "github",
        "repo": "spark-arena/sparkrun"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": false
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  "autoUpdates": false
}
