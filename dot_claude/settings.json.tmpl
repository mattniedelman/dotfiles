{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "autoCompactWindow": 200000,
  "autoMemoryEnabled": false,
  "autoUpdates": false,
  "autoUpdatesChannel": "latest",
  "effortLevel": "high",
  "enabledPlugins": {
    "agentic-actions-auditor@trailofbits": false,
    "agnix@agentsys": true,
    "ai@pydantic-skills": true,
    "ask-questions-if-underspecified@trailofbits": false,
    "audit-context-building@trailofbits": false,
    "audit-project@agentsys": false,
    "can-i-help@agentsys": false,
    "differential-review@trailofbits": false,
    "drift-detect@agentsys": false,
    "enhance@agentsys": true,
    "git-cleanup@trailofbits": false,
    "hindsight-memory@hindsight": true,
    "insecure-defaults@trailofbits": true,
    "learn@agentsys": false,
    "nono@always-further": true,
    "onboard@agentsys": true,
    "perf@agentsys": false,
    "repo-intel@agentsys": true,
    "sharp-edges@trailofbits": true,
    "skill-improver@trailofbits": true,
    "skillers@agentsys": false,
    "skypilot@skypilot": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "sync-docs@agentsys": true,
    "trailmark@trailofbits": true,
    "variant-analysis@trailofbits": true,
    "workflow-skill-design@trailofbits": true
  },
  "env": {
    "AWS_PROFILE": "claude",
    "AWS_REGION": "us-east-1",
    "AWS_SDK_LOAD_CONFIG": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "RTK_HOOK_AUDIT": "1"
  },
  "extraKnownMarketplaces": {
    "agentsys": {
      "autoUpdate": true,
      "source": {
        "repo": "agent-sh/agentsys",
        "source": "github"
      }
    },
    "hindsight": {
      "source": {
        "repo": "vectorize-io/hindsight",
        "source": "github"
      }
    },
    "knowledge-work-plugins": {
      "source": {
        "repo": "anthropics/knowledge-work-plugins",
        "source": "github"
      }
    },
    "pydantic-skills": {
      "source": {
        "repo": "pydantic/skills",
        "source": "github"
      }
    },
    "revealjs-skill": {
      "source": {
        "repo": "ryanbbrown/revealjs-skill",
        "source": "github"
      }
    },
    "skypilot": {
      "source": {
        "repo": "skypilot-org/skypilot",
        "source": "github"
      }
    },
    "trailofbits": {
      "autoUpdate": true,
      "source": {
        "repo": "trailofbits/skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/auto_lint.py",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/ascii_check.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/agnix_validate.py",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/security_audit_nudge.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/security_audit_nudge.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/block_pip.py",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/rtk-rewrite.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/worktree_placement_check.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash ~/.claude/hooks/allow_sandboxed_bash.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/steer_broad_search.py",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/basic_memory_directory_check.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "mcp__basic-memory__write_note"
      },
      {
        "hooks": [],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "resume"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "clear"
      },
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_start.py",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/session_reflect.py",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "us.anthropic.claude-sonnet-5",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Write",
      "Edit",
      "mcp__basic-memory__*",
      "mcp__beads__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_cq_cq__*",
      "Bash(chezmoi:*)",
      "Bash(bd:*)",
      "Bash(br:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(systemctl:*)",
      "Bash(aws:*)",
      "Bash(nono why *)",
      "Bash(nono profile guide)",
      "mcp__grafana__*",
      "mcp__semble__*",
      "Skill(*)"
    ],
    "ask": [
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.config/fish/config.fish)",
      "Edit(~/.config/fish/conf.d/**)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -fr *)",
      "Bash(rm -fr /)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",
      "Edit(~/.ssh/**)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": false
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "~/.local/bin/starship-claude",
    "padding": 0,
    "type": "command"
  },
  "teammateMode": "auto",
  "tui": "fullscreen",
  "verbose": false
}